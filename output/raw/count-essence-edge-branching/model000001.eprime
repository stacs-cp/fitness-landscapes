                    and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                    sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q62],
                    sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q62],
                    sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q62] + props_Explicit_2[q62],
