                   sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q60],
                   sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q60] + props_Explicit_2[q60],
                   a <lex b, a <lex c, b <lex d])
             | q60 : int(1..fin1), props_Explicit_4[q60] = -1, props_Explicit_3[q60] = 2]),
    and([and([direction[a, b] /\ direction[c, d] /\ (direction[a, d] /\ direction[c, b]) \/
              direction[b, a] /\ direction[d, c] /\ (direction[d, a] /\ direction[b, c])
