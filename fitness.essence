given nb_bits : int

given edges : set of (int, int)

letting nb_nodes be 2 ** nb_bits
letting N be domain int(0..nb_nodes-1)

$ graph
find g : matrix [N, N] of bool

such that forAll i,j : N . (i,j) in edges -> xor([g[i,j], g[j,i]])
such that forAll i,j : N , i <= j . g[i,j] \/ g[j,i] -> (i,j) in edges

$ 0 is a valley, there can be other valleys too
such that forAll i : N . !g[i,0]

$ weights
find w : matrix [N] of N
such that w[0] = 0, allDiff(w)
such that forAll i,j : N . g[i,j] -> w[i] < w[j]

$ there is a preset order on the weights of all nodes with the same number of 1s (i.e. on the same level)
$ given sameLevel : function int --> set of N
$such that forAll (_, nodes) in sameLevel . forAll {i, j} subsetEq nodes . and([ (sum k : N . toInt(g[i,k])) = (sum k : N . toInt(g[j,k]))
$                                                                              , (sum k : N . toInt(g[k,i])) = (sum k : N . toInt(g[k,j])) ]) -> w[i] < w[j]

$such that forAll i, j : N , i < j . and([ (sum k : N . toInt(g[i,k])) = (sum k : N . toInt(g[j,k]))
$                                                                              , (sum k : N . toInt(g[k,i])) = (sum k : N . toInt(g[k,j])) ]) -> w[i] < w[j]


$ new symm break edge set is the same, directions are the same but the weights are symmetric.



$ letting M be 10000

$ $ Figure 1a: no sign epistasis
$ find fig1a: int(0..M)
$ such that fig1a =
$     sum a, b, c, d : N ,
$         and([ a < b, b < c, c < d
$             , g[a,b] \/ g[b,a]
$             , g[a,c] \/ g[c,a]
$             , g[b,d] \/ g[d,b]
$             , g[c,d] \/ g[d,c] ]) .
$         toInt(g[a,b] /\ g[a,c] /\ g[b,d] /\ g[c,d])


$ $ Figure 1b: sign epistasis
$ find fig1b: int(0..M)
$ such that fig1b =
$     sum a, b, c, d : N ,
$         and([ a < b, b < c, c < d
$             , g[a,b] \/ g[b,a]
$             , g[a,c] \/ g[c,a]
$             , g[b,d] \/ g[d,b]
$             , g[c,d] \/ g[d,c] ]) .
$         toInt(g[a,b] /\ g[a,c] /\ xor([g[b,d], g[c,d]]))


$ $ Figure 1c: reverse sign epistasis
$ find fig1c: int(0..M)
$ such that fig1c =
$     sum a, b, c, d : N ,
$         and([ a < b, b < c, c < d
$             , g[a,b] \/ g[b,a]
$             , g[a,c] \/ g[c,a]
$             , g[b,d] \/ g[d,b]
$             , g[c,d] \/ g[d,c] ]) .
$         toInt(g[a,b] /\ g[a,c] /\ !g[b,d] /\ !g[c,d])

branching on [g]
