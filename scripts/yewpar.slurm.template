#!/bin/sh

#SBATCH  --partition=large-short
#SBATCH --job-name=YewPar
#SBATCH --time=02:00:00
#SBATCH --cpus-per-task=48
#SBATCH --mem=20G
#SBATCH --ntasks=4

#SBATCH --array=1-__ARRAY_COUNT__%15

module load openmpi
module load ucx

srun --mpi=pmix_v3 `sed -n "$SLURM_ARRAY_TASK_ID"p yewparcommands`
