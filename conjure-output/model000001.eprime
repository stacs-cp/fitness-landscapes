language ESSENCE' 1.0

given dimension: int
letting let1 be 2 ** dimension
find w: matrix indexed by [matrix indexed by [int(1..dimension)] of bool] of int(1..let1)
given nb_peaks: int
given fin1: int
given fin2: int
given fin3: int
given fin4: int
given fin5: int
given fin6: int
given fin7: int
given props_Explicit_1: matrix indexed by [int(1..fin1)] of int(fin2..fin3)
given props_Explicit_2: matrix indexed by [int(1..fin1)] of int(fin4..fin5)
given props_Explicit_3: matrix indexed by [int(1..fin1)] of int(1..2)
given props_Explicit_4: matrix indexed by [int(1..fin1)] of int(fin6..fin7)
find direction:
        matrix indexed by [matrix indexed by [int(1..dimension)] of bool,
                           matrix indexed by [int(1..dimension)] of bool] of
            bool
branching on [direction]
such that
    and([n1 <lex n2 -> w[n1] != w[n2]
             | n1 : matrix indexed by [int(1..dimension)] of bool, n2 : matrix indexed by [int(1..dimension)] of bool]),
    and([and([node[d] = false | d : int(1..dimension)]) -> w[node] = 1
             | node : matrix indexed by [int(1..dimension)] of bool]),
    nb_peaks >= 0 ->
    nb_peaks =
    sum([toInt(and([w[p] > w[x]
                        | x : matrix indexed by [int(1..dimension)] of bool,
                          1 = sum([toInt(p[i] != x[i]) | i : int(1..dimension)])]))
             | p : matrix indexed by [int(1..dimension)] of bool]),
    and([direction[n1, n2] <-> w[n1] <= w[n2]
             | n1 : matrix indexed by [int(1..dimension)] of bool, n2 : matrix indexed by [int(1..dimension)] of bool,
               sum([1 | i : int(1..dimension), n1[i] != n2[i]]) = 1]),
    and([direction[n1, n2] = false
             | n1 : matrix indexed by [int(1..dimension)] of bool, n2 : matrix indexed by [int(1..dimension)] of bool,
               sum([1 | i : int(1..dimension), n1[i] != n2[i]]) != 1]),
    and([or([and([w[a] < w[b], w[a] < w[c], w[a] < w[d], w[b] < w[c]; int(1..4)]) /\
             (w[a] < w[b] /\ w[a] < w[c] /\ w[d] > w[b] /\ w[d] < w[c])
