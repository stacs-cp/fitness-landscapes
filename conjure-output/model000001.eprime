language ESSENCE' 1.0

given nb_bits: int
given fin1: int
given fin2: int
given fin3: int
given fin4: int
given fin5: int
given edges_Explicit_1: matrix indexed by [int(1..fin1)] of int(fin2..fin3)
given edges_Explicit_2: matrix indexed by [int(1..fin1)] of int(fin4..fin5)
letting nb_nodes be 2 ** nb_bits
letting let1 be nb_nodes - 1
letting let2 be nb_nodes - 1
find g: matrix indexed by [int(0..let1), int(0..let2)] of bool
letting let3 be nb_nodes - 1
letting let4 be nb_nodes - 1
find w: matrix indexed by [int(0..let3)] of int(0..let4)
given nb_rse_faces: int
letting let5 be nb_nodes - 1
letting let6 be nb_nodes - 1
letting let7 be nb_nodes - 1
letting let8 be nb_nodes - 1
find rse_witnesses_Explicit_1: matrix indexed by [int(1..nb_rse_faces)] of int(0..let5)
find rse_witnesses_Explicit_2: matrix indexed by [int(1..nb_rse_faces)] of int(0..let6)
find rse_witnesses_Explicit_3: matrix indexed by [int(1..nb_rse_faces)] of int(0..let7)
find rse_witnesses_Explicit_4: matrix indexed by [int(1..nb_rse_faces)] of int(0..let8)
given nb_peaks: int
branching on [g]
such that
    and([table([i, j; int(1..2)], [[edges_Explicit_1[q7], edges_Explicit_2[q7]; int(1..2)] | q7 : int(1..fin1)]) ->
         1 = (toInt(g[i, j]) + toInt(g[j, i])) % 2
             | i : int(0..nb_nodes - 1), j : int(0..nb_nodes - 1)]),
    and([g[i, j] \/ g[j, i] ->
         table([i, j; int(1..2)], [[edges_Explicit_1[q3], edges_Explicit_2[q3]; int(1..2)] | q3 : int(1..fin1)])
             | i : int(0..nb_nodes - 1), j : int(0..nb_nodes - 1), i <= j]),
    and([!g[i, 0] | i : int(0..nb_nodes - 1)]),
    w[0] = 0,
    allDiff(w),
    and([g[i, j] -> w[i] < w[j] | i : int(0..nb_nodes - 1), j : int(0..nb_nodes - 1)]),
    and([and([allDiff([a, b, c, d; int(1..4)]), a < d, b < c, g[a, b] \/ g[b, a], g[a, c] \/ g[c, a],
              g[b, d] \/ g[d, b], g[c, d] \/ g[d, c], g[a, b] /\ g[a, c] /\ g[d, b] /\ g[d, c];
                  int(1..8)])
         ->
         or([and([rse_witnesses_Explicit_1[q9] = a, rse_witnesses_Explicit_2[q9] = b, rse_witnesses_Explicit_3[q9] = c,
                  rse_witnesses_Explicit_4[q9] = d;
                      int(1..4)])
                 | q9 : int(1..nb_rse_faces)])
             | a : int(0..nb_nodes - 1), b : int(0..nb_nodes - 1), c : int(0..nb_nodes - 1), d : int(0..nb_nodes - 1)]),
    nb_peaks = sum([toInt(and([!g[i, j] | j : int(0..nb_nodes - 1)])) | i : int(0..nb_nodes - 1)]),
    and([flatten([[rse_witnesses_Explicit_1[q5]; int(1)], [rse_witnesses_Explicit_2[q5]; int(1)],
                  [rse_witnesses_Explicit_3[q5]; int(1)], [rse_witnesses_Explicit_4[q5]; int(1)];
                      int(1..4)])
         <lex
         flatten([[rse_witnesses_Explicit_1[q5 + 1]; int(1)], [rse_witnesses_Explicit_2[q5 + 1]; int(1)],
                  [rse_witnesses_Explicit_3[q5 + 1]; int(1)], [rse_witnesses_Explicit_4[q5 + 1]; int(1)];
                      int(1..4)])
             | q5 : int(1..nb_rse_faces - 1)])

