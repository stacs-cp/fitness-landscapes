language ESSENCE' 1.0

given dimension: int
letting let1 be 2 ** dimension
find w: matrix indexed by [matrix indexed by [int(1..dimension)] of bool] of int(1..let1)
given nb_peaks: int
given fin1: int
given fin2: int
given fin3: int
given fin4: int
given fin5: int
given fin6: int
given fin7: int
given props_Explicit_1: matrix indexed by [int(1..fin1)] of int(fin2..fin3)
given props_Explicit_2: matrix indexed by [int(1..fin1)] of int(fin4..fin5)
given props_Explicit_3: matrix indexed by [int(1..fin1)] of int(1..2)
given props_Explicit_4: matrix indexed by [int(1..fin1)] of int(fin6..fin7)
branching on [w]
such that
    and([n1 <lex n2 -> w[n1] != w[n2]
             | n1 : matrix indexed by [int(1..dimension)] of bool, n2 : matrix indexed by [int(1..dimension)] of bool]),
    and([or([w[n] = weight | n : matrix indexed by [int(1..dimension)] of bool]) | weight : int(1..2 ** dimension)]),
    and([and([node[d] = false | d : int(1..dimension)]) -> w[node] = 1
             | node : matrix indexed by [int(1..dimension)] of bool]),
    nb_peaks >= 0 ->
    nb_peaks =
    sum([toInt(and([w[p] > w[x]
                        | x : matrix indexed by [int(1..dimension)] of bool,
                          1 = sum([toInt(p[i] != x[i]) | i : int(1..dimension)])]))
             | p : matrix indexed by [int(1..dimension)] of bool]),
    and([or([(w[a] < w[b] /\ w[d] > w[c] \/ w[a] > w[b] /\ w[d] < w[c]) /\
             (w[a] < w[d] /\ w[b] < w[c] \/ w[a] > w[d] /\ w[b] > w[c])
             \/
             (w[a] < w[d] /\ w[b] > w[c] \/ w[a] > w[d] /\ w[b] < w[c]) /\
             (w[a] < w[b] /\ w[d] < w[c] \/ w[a] > w[b] /\ w[d] > w[c])
                 | a : matrix indexed by [int(1..dimension)] of bool, b : matrix indexed by [int(1..dimension)] of bool,
                   c : matrix indexed by [int(1..dimension)] of bool, d : matrix indexed by [int(1..dimension)] of bool,
                   and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                   and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                   sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q27],
                   sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q27],
                   sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q27] + props_Explicit_2[q27],
                   a <lex b, a <lex c, b <lex d])
             | q27 : int(1..fin1), props_Explicit_4[q27] = -1, props_Explicit_3[q27] = 1]),
    and([and([(w[a] < w[b] /\ w[d] > w[c] \/ w[a] > w[b] /\ w[d] < w[c]) /\
              (w[a] < w[d] /\ w[b] < w[c] \/ w[a] > w[d] /\ w[b] > w[c])
              \/
              (w[a] < w[d] /\ w[b] > w[c] \/ w[a] > w[d] /\ w[b] < w[c]) /\
              (w[a] < w[b] /\ w[d] < w[c] \/ w[a] > w[b] /\ w[d] > w[c])
                  | a : matrix indexed by [int(1..dimension)] of bool,
                    b : matrix indexed by [int(1..dimension)] of bool,
                    c : matrix indexed by [int(1..dimension)] of bool,
                    d : matrix indexed by [int(1..dimension)] of bool,
                    and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                    and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                    sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q29],
                    sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q29],
                    sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q29] + props_Explicit_2[q29],
                    a <lex b, a <lex c, b <lex d])
             | q29 : int(1..fin1), props_Explicit_4[q29] = -2, props_Explicit_3[q29] = 1]),
    and([props_Explicit_4[q35] =
         sum([toInt((w[a] < w[b] /\ w[d] > w[c] \/ w[a] > w[b] /\ w[d] < w[c]) /\
                    (w[a] < w[d] /\ w[b] < w[c] \/ w[a] > w[d] /\ w[b] > w[c])
                    \/
                    (w[a] < w[d] /\ w[b] > w[c] \/ w[a] > w[d] /\ w[b] < w[c]) /\
                    (w[a] < w[b] /\ w[d] < w[c] \/ w[a] > w[b] /\ w[d] > w[c]))
                  | a : matrix indexed by [int(1..dimension)] of bool,
                    b : matrix indexed by [int(1..dimension)] of bool,
                    c : matrix indexed by [int(1..dimension)] of bool,
                    d : matrix indexed by [int(1..dimension)] of bool,
                    and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                    and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                    sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q35],
                    sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q35],
                    sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q35] + props_Explicit_2[q35],
                    a <lex b, a <lex c, b <lex d])
             | q35 : int(1..fin1), props_Explicit_4[q35] >= 0, props_Explicit_3[q35] = 1]),
    and([or([w[a] < w[b] /\ w[d] > w[c] /\ (w[a] < w[d] /\ w[b] > w[c]) \/
             w[a] > w[b] /\ w[d] < w[c] /\ (w[a] > w[d] /\ w[b] < w[c])
                 | a : matrix indexed by [int(1..dimension)] of bool, b : matrix indexed by [int(1..dimension)] of bool,
                   c : matrix indexed by [int(1..dimension)] of bool, d : matrix indexed by [int(1..dimension)] of bool,
                   and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                   and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                   sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q43],
                   sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q43],
                   sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q43] + props_Explicit_2[q43],
                   a <lex b, a <lex c, b <lex d])
             | q43 : int(1..fin1), props_Explicit_4[q43] = -1, props_Explicit_3[q43] = 2]),
    and([and([w[a] < w[b] /\ w[d] > w[c] /\ (w[a] < w[d] /\ w[b] > w[c]) \/
              w[a] > w[b] /\ w[d] < w[c] /\ (w[a] > w[d] /\ w[b] < w[c])
                  | a : matrix indexed by [int(1..dimension)] of bool,
                    b : matrix indexed by [int(1..dimension)] of bool,
                    c : matrix indexed by [int(1..dimension)] of bool,
                    d : matrix indexed by [int(1..dimension)] of bool,
                    and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                    and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                    sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q19],
                    sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q19],
                    sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q19] + props_Explicit_2[q19],
                    a <lex b, a <lex c, b <lex d])
