given dimension : int

letting DIM be domain int(1..dimension)
letting NODE be domain matrix [DIM] of bool
letting PROP_TYPE be new type enum {SE, RSE}

$ -1 means ignore
given nb_peaks : int

$ dimensionality of the face
$ 1x1 or 2x1 etc
given props : set of
        ( int           $ dimension 1
        , int           $ dimension 2
        , PROP_TYPE     $ SE/RSE
        , int           $ exact count if >=0
                        $ -1 to mean at least one
                        $ -2 to mean all
        )


$ --------------------------------------------------------------------------------
$ direction

$ we only care about the direction of the nodes when counting

$we only look for directions
$direction[i,j] means we point from i to j
find direction : matrix [NODE, NODE] of bool

such that
    forAll n1, n2 : NODE
        $when there is an edge in the base graph
        , sum([1 | i : DIM, n1[i] != n2[i]]) = 1
        $we must have a direction (but not going both ways)
        . xor([direction[n1, n2],  direction[n2, n1] ])

such that
    forAll n1, n2 : NODE
        $when there is no edge in the base graph
        , sum([1 | i : DIM, n1[i] != n2[i]]) != 1
        $we have no directions to mean no edge 
        . (!direction[n1, n2]) /\ (!direction[n2, n1])

$0 is a source
$such that 
$    forAll n1, n2 : NODE . (and([ n1[d] = false | d : DIM ]) 
$                            /\  1 = sum i : int(1..dimension) . toInt(n1[i] != n2[i]))
$                            -> direction[n1,n2]


$ a node is a peak if its weight is larger  than all of its neighbours' weights
such that
    nb_peaks >= 0 ->
    nb_peaks =
    sum([ toInt(and([ direction[x,p] $we point all neighbours to p
                    | x : NODE
                    $ neighbour is a node who has only 1 bit different from p
                    , 1 = sum i : int(1..dimension) . toInt(p[i] != x[i])   $alternative: count of 1 in row is 0
                    ]))
        | p : NODE
        ])


branching on [direction]

$ --------------------------------------------------------------------------------

$graph is acyclic 
find hasPaths : matrix [NODE, NODE] of bool

such that 
    forAll n1, n2 : NODE
        $when there is an edge in the base graph
        , sum([1 | i : DIM, n1[i] != n2[i]]) = 1
        $if there's an edge from n1->n2, then there is a path from n1 to n2
        . (direction[n1, n2] -> hasPaths[n1, n2])

such that
    forAll n1, n2, n3 : NODE
        $when they are all different
        , allDiff([n1,n2,n3])
        $transitive
        . hasPaths[n1, n2] /\ hasPaths[n2, n3]
        -> hasPaths[n1, n3]

such that
    forAll n1, n2: NODE
        $when there is an edge in the base graph
        , sum([1 | i : DIM, n1[i] != n2[i]]) = 1
        $if there is a path from n1 to n2, then we don't want an edge from n2 to n1
        . !(hasPaths[n1, n2] /\ direction[n2,n1])

$ --------------------------------------------------------------------------------
$symmetry breaking using auts of cube
$symmetry is defined by the permutation and flipping of the bits (size = 2^n n!)


such that

forAll b : NODE. $choose which bits to flip
    forAll p: matrix indexed by [DIM] of DIM, allDiff(p). $choose how to permute bits 
        [direction[i,j] | i,j: NODE] <=lex 
             [direction[[ [i[p[k]], !i[p[k]]; int(0..1)][toInt(b[k])] | k: DIM] ,
                        [ [j[p[k]], !j[p[k]]; int(0..1)][toInt(b[k])] | k: DIM] 
                       ]| i,j: NODE]




$ --------------------------------------------------------------------------------

$ SE, at least one
such that
[

or([

    (
        (
            ((direction[a,b] /\ direction[c,d]) 
            \/ 
            (direction[b,a] /\ direction[d,c]))
        /\
            ((direction[a,d] /\ direction[b,c]) 
            \/ 
            (direction[d,a] /\ direction[c,b]))
        )
        \/
        (
            ((direction[a,b] /\ direction[c,d]) 
            \/ 
            (direction[b,a] /\ direction[d,c]))
        /\
            ((direction[a,d] /\ direction[b,c]) 
            \/ 
            (direction[d,a] /\ direction[c,b]))
        )
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count = -1
, prop_type = SE
]


$ --------------------------------------------------------------------------------
$ SE, all
such that
[

and([

    (
        (
            ((direction[a,b] /\ direction[c,d]) 
            \/ 
            (direction[b,a] /\ direction[d,c]))
        /\
            ((direction[a,d] /\ direction[b,c]) 
            \/ 
            (direction[d,a] /\ direction[c,b]))
        )
        \/
        (
            ((direction[a,b] /\ direction[c,d]) 
            \/ 
            (direction[b,a] /\ direction[d,c]))
        /\
            ((direction[a,d] /\ direction[b,c]) 
            \/ 
            (direction[d,a] /\ direction[c,b]))
        )
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count = -2
, prop_type = SE
]


$ --------------------------------------------------------------------------------
$ SE, exact count
such that
[

count = sum([

    toInt(
        (
            ((direction[a,b] /\ direction[c,d]) 
            \/ 
            (direction[b,a] /\ direction[d,c]))
        /\
            ((direction[a,d] /\ direction[b,c]) 
            \/ 
            (direction[d,a] /\ direction[c,b]))
        )
        \/
        (
            ((direction[a,b] /\ direction[c,d]) 
            \/ 
            (direction[b,a] /\ direction[d,c]))
        /\
            ((direction[a,d] /\ direction[b,c]) 
            \/ 
            (direction[d,a] /\ direction[c,b]))
        )
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count >= 0
, prop_type = SE
]




$ --------------------------------------------------------------------------------
$ RSE, at least one
such that
[

or([

    (
        ((direction[a,b] /\ direction[c,d]) 
        /\
        (direction[a,d] /\ direction[c,b]))
    \/
        ((direction[b,a] /\ direction[d,c]) 
        /\
        (direction[d,a] /\ direction[b,c]))
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count = -1
, prop_type = RSE
]


$ --------------------------------------------------------------------------------
$ RSE, all
such that
[

and([

(
        ((direction[a,b] /\ direction[c,d]) 
        /\
        (direction[a,d] /\ direction[c,b]))
    \/
        ((direction[b,a] /\ direction[d,c]) 
        /\
        (direction[d,a] /\ direction[b,c]))
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count = -2
, prop_type = RSE
]


$ --------------------------------------------------------------------------------
$ RSE, exact count
such that
[

count = sum([

    toInt(
        ((direction[a,b] /\ direction[c,d]) 
        /\
        (direction[a,d] /\ direction[c,b]))
    \/
        ((direction[b,a] /\ direction[d,c]) 
        /\
        (direction[d,a] /\ direction[b,c]))
    )


    | 
    $ for each face
    a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m


    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count >= 0
, prop_type = RSE

]



