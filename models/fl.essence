given dimension : int

letting DIM be domain int(1..dimension)
letting NODE be domain matrix [DIM] of bool

$ find w : function (total, injective) NODE --> int(1..2**dimension)
find w : matrix [matrix [DIM] of bool] of int(1..2**dimension)

$ injective
such that forAll n1,n2 : NODE . n1 <lex n2 -> w[n1] != w[n2]

such that forAll node : NODE . and([ bit = false | d : DIM, letting bit be node[d] ]) -> w[node] = 1

letting PROP_TYPE be new type enum {SE, RSE}

$ -1 means ignore
given nb_peaks : int

$ a node is a peak if its weight is larger  than all of its neighbours' weights
such that
    nb_peaks >= 0 ->
    nb_peaks =
    sum([ toInt(and([ w[p] > w[x]
                    | x : NODE
                    $ neighbour is a node who has only 1 bit different from p
                    , 1 = sum i : int(1..dimension) . toInt(p[i] != x[i])
                    ]))
        | p : NODE
        ])

$ dimensionality of the face
$ 1x1 or 2x1 etc
given props : set of
        ( int           $ dimension 1
        , int           $ dimension 2
        , PROP_TYPE     $ SE/RSE
        , int           $ exact count if >=0
                        $ -1 to mean at least one
                        $ -2 to mean all
        )


$ This is all the (a,b,c,d) tuples we will consider
$ Symmetry break 1. w[a] is smallest of them all. 
$ Symmetry break 2. w[b] < w[c].

$ This is how we decide whether (a,b,c,d) has the given property
$ RSE w[a] < w[b] /\ w[a] < w[c] /\ w[d] < w[b] /\ w[d] < w[c]
$ SE  w[a] < w[b] /\ w[a] < w[c] /\ w[d] > w[b] /\ w[d] < w[c]


$ --------------------------------------------------------------------------------
$ SE, at least one
such that
[

or([

    $ SE definition
    w[a] < w[b] /\ w[a] < w[c] /\ w[d] > w[b] /\ w[d] < w[c]

    $ the index of n bits that are different in the n dimension
    $ for n=2, diff_n will be (1,2), (1,3), (2,3)
    | diff_n : set (size n) of int(1..dimension)

    $ the index of m bits that are different in the m dimension
    $ for m=1, diff_m will be 1,2,3
    , diff_m : set (size m) of int(1..dimension)

    $ diff_n and diff_m have to be disjoint
    $ the combinations are
    $ each one is a kind of face
    $ (1,2), 3
    $ (1,3), 2
    $ (2,3), 1
    , |diff_n intersect diff_m| = 0

    $ enforce a property on a 4 nodes
    $ a, b, c d

    , a,b,c,d : NODE

    $ b is flipping the diff_n bits of a
    , forAll i : DIM . b[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n)]

    $ c is flipping the diff_m bits of a
    , forAll i : DIM . c[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_m)]

    $ d is flipping the diff_n and diff_m bits of a
    , forAll i : DIM . d[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n union diff_m)]

    $ symmetry breaking
    , w[a] < w[b], w[a] < w[c], w[a] < w[d]
    , w[b] < w[c]
    ])

| (n, m, prop_type, count) <- props
, count = -1
, prop_type = SE
]


$ --------------------------------------------------------------------------------
$ SE, all
such that
[

and([

    $ SE definition
    w[a] < w[b] /\ w[a] < w[c] /\ w[d] > w[b] /\ w[d] < w[c]

    $ the index of n bits that are different in the n dimension
    $ for n=2, diff_n will be (1,2), (1,3), (2,3)
    | diff_n : set (size n) of int(1..dimension)

    $ the index of m bits that are different in the m dimension
    $ for m=1, diff_m will be 1,2,3
    , diff_m : set (size m) of int(1..dimension)

    $ diff_n and diff_m have to be disjoint
    $ the combinations are
    $ each one is a kind of face
    $ (1,2), 3
    $ (1,3), 2
    $ (2,3), 1
    , |diff_n intersect diff_m| = 0

    $ enforce a property on a 4 nodes
    $ a, b, c d

    , a,b,c,d : NODE

    $ b is flipping the diff_n bits of a
    , forAll i : DIM . b[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n)]

    $ c is flipping the diff_m bits of a
    , forAll i : DIM . c[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_m)]

    $ d is flipping the diff_n and diff_m bits of a
    , forAll i : DIM . d[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n union diff_m)]

    $ symmetry breaking
    , w[a] < w[b], w[a] < w[c], w[a] < w[d]
    , w[b] < w[c]
    ])

| (n, m, prop_type, count) <- props
, count = -2
, prop_type = SE
]


$ --------------------------------------------------------------------------------
$ SE, exact count
such that
[

count = sum([

    $ SE definition
    toInt(w[a] < w[b] /\ w[a] < w[c] /\ w[d] > w[b] /\ w[d] < w[c])

    $ the index of n bits that are different in the n dimension
    $ for n=2, diff_n will be (1,2), (1,3), (2,3)
    | diff_n : set (size n) of int(1..dimension)

    $ the index of m bits that are different in the m dimension
    $ for m=1, diff_m will be 1,2,3
    , diff_m : set (size m) of int(1..dimension)

    $ diff_n and diff_m have to be disjoint
    $ the combinations are
    $ each one is a kind of face
    $ (1,2), 3
    $ (1,3), 2
    $ (2,3), 1
    , |diff_n intersect diff_m| = 0

    $ enforce a property on a 4 nodes
    $ a, b, c d

    , a,b,c,d : NODE

    $ b is flipping the diff_n bits of a
    , forAll i : DIM . b[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n)]

    $ c is flipping the diff_m bits of a
    , forAll i : DIM . c[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_m)]

    $ d is flipping the diff_n and diff_m bits of a
    , forAll i : DIM . d[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n union diff_m)]

    $ symmetry breaking
    , w[a] < w[b], w[a] < w[c], w[a] < w[d]
    , w[b] < w[c]
    ])

| (n, m, prop_type, count) <- props
, count >= 0
, prop_type = SE
]




$ --------------------------------------------------------------------------------
$ RSE, at least one
such that
[

or([

    $ RSE definition
    w[a] < w[b] /\ w[a] < w[c] /\ w[d] < w[b] /\ w[d] < w[c]

    $ the index of n bits that are different in the n dimension
    $ for n=2, diff_n will be (1,2), (1,3), (2,3)
    | diff_n : set (size n) of int(1..dimension)

    $ the index of m bits that are different in the m dimension
    $ for m=1, diff_m will be 1,2,3
    , diff_m : set (size m) of int(1..dimension)

    $ diff_n and diff_m have to be disjoint
    $ the combinations are
    $ each one is a kind of face
    $ (1,2), 3
    $ (1,3), 2
    $ (2,3), 1
    , |diff_n intersect diff_m| = 0

    $ enforce a property on a 4 nodes
    $ a, b, c d

    , a,b,c,d : NODE

    $ b is flipping the diff_n bits of a
    , forAll i : DIM . b[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n)]

    $ c is flipping the diff_m bits of a
    , forAll i : DIM . c[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_m)]

    $ d is flipping the diff_n and diff_m bits of a
    , forAll i : DIM . d[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n union diff_m)]

    $ symmetry breaking
    , w[a] < w[b], w[a] < w[c], w[a] < w[d]
    , w[b] < w[c]
    ])

| (n, m, prop_type, count) <- props
, count = -1
, prop_type = RSE
]


$ --------------------------------------------------------------------------------
$ RSE, all
such that
[

and([

    $ RSE definition
    w[a] < w[b] /\ w[a] < w[c] /\ w[d] < w[b] /\ w[d] < w[c]

    $ the index of n bits that are different in the n dimension
    $ for n=2, diff_n will be (1,2), (1,3), (2,3)
    | diff_n : set (size n) of int(1..dimension)

    $ the index of m bits that are different in the m dimension
    $ for m=1, diff_m will be 1,2,3
    , diff_m : set (size m) of int(1..dimension)

    $ diff_n and diff_m have to be disjoint
    $ the combinations are
    $ each one is a kind of face
    $ (1,2), 3
    $ (1,3), 2
    $ (2,3), 1
    , |diff_n intersect diff_m| = 0

    $ enforce a property on a 4 nodes
    $ a, b, c d

    , a,b,c,d : NODE

    $ b is flipping the diff_n bits of a
    , forAll i : DIM . b[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n)]

    $ c is flipping the diff_m bits of a
    , forAll i : DIM . c[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_m)]

    $ d is flipping the diff_n and diff_m bits of a
    , forAll i : DIM . d[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n union diff_m)]

    $ symmetry breaking
    , w[a] < w[b], w[a] < w[c], w[a] < w[d]
    , w[b] < w[c]
    ])

| (n, m, prop_type, count) <- props
, count = -2
, prop_type = RSE
]


$ --------------------------------------------------------------------------------
$ RSE, exact count
such that
[

count = sum([

    $ RSE definition
    toInt(w[a] < w[b] /\ w[a] < w[c] /\ w[d] < w[b] /\ w[d] < w[c])

    $ the index of n bits that are different in the n dimension
    $ for n=2, diff_n will be (1,2), (1,3), (2,3)
    | diff_n : set (size n) of int(1..dimension)

    $ the index of m bits that are different in the m dimension
    $ for m=1, diff_m will be 1,2,3
    , diff_m : set (size m) of int(1..dimension)

    $ diff_n and diff_m have to be disjoint
    $ the combinations are
    $ each one is a kind of face
    $ (1,2), 3
    $ (1,3), 2
    $ (2,3), 1
    , |diff_n intersect diff_m| = 0

    $ enforce a property on a 4 nodes
    $ a, b, c d

    , a,b,c,d : NODE

    $ b is flipping the diff_n bits of a
    , forAll i : DIM . b[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n)]

    $ c is flipping the diff_m bits of a
    , forAll i : DIM . c[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_m)]

    $ d is flipping the diff_n and diff_m bits of a
    , forAll i : DIM . d[i] = [ a[i], !a[i] ; int(0..1)][toInt(i in diff_n union diff_m)]

    $ symmetry breaking
    , w[a] < w[b], w[a] < w[c], w[a] < w[d]
    , w[b] < w[c]
    ])

| (n, m, prop_type, count) <- props
, count >= 0
, prop_type = RSE
]
