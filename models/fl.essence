given dimension : int

letting DIM be domain int(1..dimension)
letting NODE be domain matrix [DIM] of bool

$ find w : function (total, injective) NODE --> int(1..2**dimension)
find w : matrix [NODE] of int(1..2**dimension)

$ injective
such that forAll n1,n2 : NODE . n1 <lex n2 -> w[n1] != w[n2]
such that forAll weight : int(1..2**dimension) . exists n : NODE . w[n] = weight

such that forAll node : NODE . and([ bit = false | d : DIM, letting bit be node[d] ]) -> w[node] = 1

letting PROP_TYPE be new type enum {SE, RSE}

$ -1 means ignore
given nb_peaks : int

$ a node is a peak if its weight is larger  than all of its neighbours' weights
such that
    nb_peaks >= 0 ->
    nb_peaks =
    sum([ toInt(and([ w[p] > w[x]
                    | x : NODE
                    $ neighbour is a node who has only 1 bit different from p
                    , 1 = sum i : int(1..dimension) . toInt(p[i] != x[i])
                    ]))
        | p : NODE
        ])

$ dimensionality of the face
$ 1x1 or 2x1 etc
given props : set of
        ( int           $ dimension 1
        , int           $ dimension 2
        , PROP_TYPE     $ SE/RSE
        , int           $ exact count if >=0
                        $ -1 to mean at least one
                        $ -2 to mean all
        )


$ --------------------------------------------------------------------------------
$ direction

$ we only care about the direction of the nodes when counting

find direction : matrix [NODE, NODE] of bool

such that
    forAll n1, n2 : NODE
        , sum([1 | i : DIM, n1[i] != n2[i]]) = 1
        . direction[n1, n2] <-> w[n1] <= w[n2]
such that
    forAll n1, n2 : NODE
        , sum([1 | i : DIM, n1[i] != n2[i]]) != 1
        . direction[n1, n2] = false



branching on [direction]

$ --------------------------------------------------------------------------------
$assuming we always want 00..0 to have weight 0, then we can still permute the first layer (everything else will follow suit)
$symmetry break by forcing the weights of the first layer to be in order 
$to uncover the non-symmetric counts, ... ?


$ such that 
$     forAll node1, node2 : NODE .
$         forAll i : int(1..dimension-1). 
$             and([node1[d] = false | d:DIM, d!=i]) /\ node1[i]=true 
$             /\ 
$             and([node2[d] = false | d:DIM, d!=i+1]) /\ node2[i+1]=true
$             -> 
$             w[node1] < w[node2]

$without this sb constraint (but still setting weight of 000 as 0), then we will get Manda's RSE numbers


$ --------------------------------------------------------------------------------
$ SE, at least one
such that
[

or([

    $ SE definition
    ((
        ((w[a] < w[b] /\ w[d] > w[c]) 
        \/ 
        (w[a] > w[b] /\ w[d] < w[c]))
    /\
        ((w[a] < w[d] /\ w[b] < w[c]) 
        \/ 
        (w[a] > w[d] /\ w[b] > w[c]))
    )
    \/$need this for n=m
    (
        ((w[a] < w[d] /\ w[b] > w[c]) 
        \/ 
        (w[a] > w[d] /\ w[b] < w[c]))
    /\
        ((w[a] < w[b] /\ w[d] < w[c]) 
        \/ 
        (w[a] > w[b] /\ w[d] > w[c]))
    ))


    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count = -1
, prop_type = SE
]


$ --------------------------------------------------------------------------------
$ SE, all
such that
[

and([

    ((
        ((w[a] < w[b] /\ w[d] > w[c]) 
        \/ 
        (w[a] > w[b] /\ w[d] < w[c]))
    /\
        ((w[a] < w[d] /\ w[b] < w[c]) 
        \/ 
        (w[a] > w[d] /\ w[b] > w[c]))
    )
    \/$need this for n=m
    (
        ((w[a] < w[d] /\ w[b] > w[c]) 
        \/ 
        (w[a] > w[d] /\ w[b] < w[c]))
    /\
        ((w[a] < w[b] /\ w[d] < w[c]) 
        \/ 
        (w[a] > w[b] /\ w[d] > w[c]))
    ))


    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count = -2
, prop_type = SE
]


$ --------------------------------------------------------------------------------
$ SE, exact count
such that
[

count = sum([

    toInt((
        ((w[a] < w[b] /\ w[d] > w[c]) 
        \/ 
        (w[a] > w[b] /\ w[d] < w[c]))
    /\
        ((w[a] < w[d] /\ w[b] < w[c]) 
        \/ 
        (w[a] > w[d] /\ w[b] > w[c]))
    )
    \/$need this for n=m
    (
        ((w[a] < w[d] /\ w[b] > w[c]) 
        \/ 
        (w[a] > w[d] /\ w[b] < w[c]))
    /\
        ((w[a] < w[b] /\ w[d] < w[c]) 
        \/ 
        (w[a] > w[b] /\ w[d] > w[c]))
    ))


    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count >= 0
, prop_type = SE
]



$ --------------------------------------------------------------------------------
$ RSE, at least one
such that
[

or([

    (
        ((w[a] < w[b] /\ w[d] > w[c]) 
        /\
        (w[a] < w[d] /\ w[b] > w[c]))
    \/
        ((w[a] > w[b] /\ w[d] < w[c]) 
        /\
        (w[a] > w[d] /\ w[b] < w[c]))
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count = -1
, prop_type = RSE
]


$ --------------------------------------------------------------------------------
$ RSE, all
such that
[

and([

    (
        ((w[a] < w[b] /\ w[d] > w[c]) 
        /\
        (w[a] < w[d] /\ w[b] > w[c]))
    \/
        ((w[a] > w[b] /\ w[d] < w[c]) 
        /\
        (w[a] > w[d] /\ w[b] < w[c]))
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count = -2
, prop_type = RSE
]


$ --------------------------------------------------------------------------------
$ RSE, exact count
such that
[

count = sum([

    toInt(
    
        ((w[a] < w[b] /\ w[d] > w[c]) 
        /\
        (w[a] < w[d] /\ w[b] > w[c]))
    \/
        ((w[a] > w[b] /\ w[d] < w[c]) 
        /\
        (w[a] > w[d] /\ w[b] < w[c]))
    
    )


    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != d[i] <-> b[i] != c[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != d[i]])= m
    , sum([1 | i : DIM, a[i] != c[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , a <lex c
    , b <lex d   $note this is just for n=m
    ])

| (n, m, prop_type, count) <- props
, count >= 0
, prop_type = RSE
]




$conjure solve fl.essence test.param --number-of-solutions=all --output-format=json --solutions-in-one-file