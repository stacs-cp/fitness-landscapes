given dimension : int

letting DIM be domain int(1..dimension)
letting NODE be domain matrix [DIM] of bool

$ find w : function (total, injective) NODE --> int(1..2**dimension)
find w : matrix [NODE] of int(1..2**dimension)

$ injective
such that forAll n1,n2 : NODE . n1 <lex n2 -> w[n1] != w[n2]
such that forAll weight : int(1..2**dimension) . exists n : NODE . w[n] = weight

such that forAll node : NODE . and([ bit = false | d : DIM, letting bit be node[d] ]) -> w[node] = 1

letting PROP_TYPE be new type enum {SE, RSE}

$ -1 means ignore
given nb_peaks : int

$ a node is a peak if its weight is larger  than all of its neighbours' weights
such that
    nb_peaks >= 0 ->
    nb_peaks =
    sum([ toInt(and([ w[p] > w[x]
                    | x : NODE
                    $ neighbour is a node who has only 1 bit different from p
                    , 1 = sum i : int(1..dimension) . toInt(p[i] != x[i])
                    ]))
        | p : NODE
        ])

$ dimensionality of the face
$ 1x1 or 2x1 etc
given props : set of
        ( int           $ dimension 1
        , int           $ dimension 2
        , PROP_TYPE     $ SE/RSE
        , int           $ exact count if >=0
                        $ -1 to mean at least one
                        $ -2 to mean all
        )


$ This is all the (a,b,c,d) tuples we will consider
$ Symmetry break 1. w[a] is smallest of them all. 
$ Symmetry break 2. w[b] < w[c].

$ This is how we decide whether (a,b,c,d) has the given property
$ RSE w[a] < w[b] /\ w[a] < w[c] /\ w[d] < w[b] /\ w[d] < w[c]
$ SE  w[a] < w[b] /\ w[a] < w[c] /\ w[d] > w[b] /\ w[d] < w[c]

$ --------------------------------------------------------------------------------
$ direction

$ we only care about the direction of the nodes when counting

find direction : matrix [NODE, NODE] of bool

such that
    forAll n1, n2 : NODE
        , sum([1 | i : DIM, n1[i] != n2[i]]) = 1
        . direction[n1, n2] <-> w[n1] <= w[n2]
such that
    forAll n1, n2 : NODE
        , sum([1 | i : DIM, n1[i] != n2[i]]) != 1
        . direction[n1, n2] = false

branching on [direction]

$ --------------------------------------------------------------------------------
$ SE, at least one
such that
[

or([

    $ SE definition
    ((w[a] < w[b] /\ w[a] < w[c] /\ w[b] < w[d] /\ w[d] < w[c])
    $\/ (w[a] < w[b] /\ w[a] < w[c] /\ w[c] < w[d] /\ w[d] < w[b])
    \/ (w[b] < w[a] /\ w[b] < w[d] /\ w[d] < w[c] /\ w[c] < w[a])
    $\/ (w[b] < w[a] /\ w[b] < w[d] /\ w[a] < w[c] /\ w[c] < w[d]) 
    \/ (w[d] < w[b] /\ w[d] < w[c] /\ w[c] < w[a] /\ w[a] < w[b])
    $\/ (w[d] < w[b] /\ w[d] < w[c] /\ w[b] < w[a] /\ w[a] < w[c])
    \/ (w[c] < w[a] /\ w[c] < w[d] /\ w[a] < w[b] /\ w[b] < w[d])
    $\/ (w[c] < w[a] /\ w[c] < w[d] /\ w[d] < w[b] /\ w[b] < w[a])
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != c[i] <-> b[i] != d[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != c[i]])= m
    , sum([1 | i : DIM, a[i] != d[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , b <lex c
    , c <lex d
    ])

| (n, m, prop_type, count) <- props
, count = -1
, prop_type = SE
]


$ --------------------------------------------------------------------------------
$ SE, all
such that
[

and([

    $ SE definition
    ((w[a] < w[b] /\ w[a] < w[c] /\ w[b] < w[d] /\ w[d] < w[c])
    $\/ (w[a] < w[b] /\ w[a] < w[c] /\ w[c] < w[d] /\ w[d] < w[b])
    \/ (w[b] < w[a] /\ w[b] < w[d] /\ w[d] < w[c] /\ w[c] < w[a])
    $\/ (w[b] < w[a] /\ w[b] < w[d] /\ w[a] < w[c] /\ w[c] < w[d]) 
    \/ (w[d] < w[b] /\ w[d] < w[c] /\ w[c] < w[a] /\ w[a] < w[b])
    $\/ (w[d] < w[b] /\ w[d] < w[c] /\ w[b] < w[a] /\ w[a] < w[c])
    \/ (w[c] < w[a] /\ w[c] < w[d] /\ w[a] < w[b] /\ w[b] < w[d])
    $\/ (w[c] < w[a] /\ w[c] < w[d] /\ w[d] < w[b] /\ w[b] < w[a])
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != c[i] <-> b[i] != d[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != c[i]])= m
    , sum([1 | i : DIM, a[i] != d[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , b <lex c
    , c <lex d
    ])

| (n, m, prop_type, count) <- props
, count = -2
, prop_type = SE
]


$ --------------------------------------------------------------------------------
$ SE, exact count
such that
[

count = sum([

    $ SE definition
    toInt((w[a] < w[b] /\ w[a] < w[c] /\ w[b] < w[d] /\ w[d] < w[c])
    $\/ (w[a] < w[b] /\ w[a] < w[c] /\ w[c] < w[d] /\ w[d] < w[b])
    \/ (w[b] < w[a] /\ w[b] < w[d] /\ w[d] < w[c] /\ w[c] < w[a])
    $\/ (w[b] < w[a] /\ w[b] < w[d] /\ w[a] < w[c] /\ w[c] < w[d]) 
    \/ (w[d] < w[b] /\ w[d] < w[c] /\ w[c] < w[a] /\ w[a] < w[b])
    $\/ (w[d] < w[b] /\ w[d] < w[c] /\ w[b] < w[a] /\ w[a] < w[c])
    \/ (w[c] < w[a] /\ w[c] < w[d] /\ w[a] < w[b] /\ w[b] < w[d])
    $\/ (w[c] < w[a] /\ w[c] < w[d] /\ w[d] < w[b] /\ w[b] < w[a])
    )

    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != c[i] <-> b[i] != d[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != c[i]])= m
    , sum([1 | i : DIM, a[i] != d[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , b <lex c
    , c <lex d
    ])

| (n, m, prop_type, count) <- props
, count >= 0
, prop_type = SE
]




$ --------------------------------------------------------------------------------
$ RSE, at least one
such that
[

or([

    $ RSE definition
    ((w[a] < w[b] /\ w[a] < w[c] /\ w[d] < w[b] /\ w[d] < w[c])
    \/ (w[b] < w[a] /\ w[b] < w[d] /\ w[c] < w[a] /\ w[c] < w[d]))


    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != c[i] <-> b[i] != d[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != c[i]])= m
    , sum([1 | i : DIM, a[i] != d[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , b <lex c
    , c <lex d
    ])

| (n, m, prop_type, count) <- props
, count = -1
, prop_type = RSE
]


$ --------------------------------------------------------------------------------
$ RSE, all
such that
[

and([

    $ RSE definition
    ((w[a] < w[b] /\ w[a] < w[c] /\ w[d] < w[b] /\ w[d] < w[c])
    \/ (w[b] < w[a] /\ w[b] < w[d] /\ w[c] < w[a] /\ w[c] < w[d]))


    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != c[i] <-> b[i] != d[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != c[i]])= m
    , sum([1 | i : DIM, a[i] != d[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , b <lex c
    , c <lex d
    ])

| (n, m, prop_type, count) <- props
, count = -2
, prop_type = RSE
]


$ --------------------------------------------------------------------------------
$ RSE, exact count
such that
[

count = sum([

    $ RSE definition
    toInt((w[a] < w[b] /\ w[a] < w[c] /\ w[d] < w[b] /\ w[d] < w[c])
    \/ (w[b] < w[a] /\ w[b] < w[d] /\ w[c] < w[a] /\ w[c] < w[d]))


    | a,b,c,d : NODE
    , forAll i : DIM . a[i] != b[i] <-> c[i] != d[i]
    , forAll i : DIM . a[i] != c[i] <-> b[i] != d[i]
    , sum([1 | i : DIM, a[i] != b[i]])= n
    , sum([1 | i : DIM, a[i] != c[i]])= m
    , sum([1 | i : DIM, a[i] != d[i]])= n + m

    $ symmetry breaking, this will look for 1xn faces, which we believe to be equivalent to nx1 faces??
    , a <lex b
    , b <lex c
    , c <lex d
    ])

| (n, m, prop_type, count) <- props
, count >= 0
, prop_type = RSE
]

