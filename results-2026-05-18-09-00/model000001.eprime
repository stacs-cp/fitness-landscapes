language ESSENCE' 1.0

given dimension: int
given nb_peaks: int
given fin1: int
given fin2: int
given fin3: int
given fin4: int
given fin5: int
given fin6: int
given fin7: int
given props_Explicit_1: matrix indexed by [int(1..fin1)] of int(fin2..fin3)
given props_Explicit_2: matrix indexed by [int(1..fin1)] of int(fin4..fin5)
given props_Explicit_3: matrix indexed by [int(1..fin1)] of int(1..2)
given props_Explicit_4: matrix indexed by [int(1..fin1)] of int(fin6..fin7)
find direction:
        matrix indexed by [matrix indexed by [int(1..dimension)] of bool,
                           matrix indexed by [int(1..dimension)] of bool] of
            bool
branching on [direction]
find hasPaths:
        matrix indexed by [matrix indexed by [int(1..dimension)] of bool,
                           matrix indexed by [int(1..dimension)] of bool] of
            bool
such that
    and([1 = (toInt(direction[n1, n2]) + toInt(direction[n2, n1])) % 2
             | n1 : matrix indexed by [int(1..dimension)] of bool, n2 : matrix indexed by [int(1..dimension)] of bool,
               sum([1 | i : int(1..dimension), n1[i] != n2[i]]) = 1]),
    and([!direction[n1, n2] /\ !direction[n2, n1]
             | n1 : matrix indexed by [int(1..dimension)] of bool, n2 : matrix indexed by [int(1..dimension)] of bool,
               sum([1 | i : int(1..dimension), n1[i] != n2[i]]) != 1]),
    and([and([n1[d] = false | d : int(1..dimension)]) /\ 1 = sum([toInt(n1[i] != n2[i]) | i : int(1..dimension)]) ->
         direction[n1, n2]
             | n1 : matrix indexed by [int(1..dimension)] of bool, n2 : matrix indexed by [int(1..dimension)] of bool]),
    nb_peaks >= 0 ->
    nb_peaks =
    sum([toInt(and([direction[x, p]
                        | x : matrix indexed by [int(1..dimension)] of bool,
                          1 = sum([toInt(p[i] != x[i]) | i : int(1..dimension)])]))
             | p : matrix indexed by [int(1..dimension)] of bool]),
    and([false
             | q61 : int(1..fin1), dimension % 2 = 1, props_Explicit_4[q61] > 0, props_Explicit_4[q61] % 2 = 1,
               props_Explicit_3[q61] = 1]),
    and([(or([x[q31] != y[q31] | q31 : int(1..dimension)]) \/ or([x[q31] != y[q31] | q31 : int(1..dimension)])) /\
         sum([1 | i : int(1..dimension), x[i] != y[i]]) = 1
         /\ direction[x, y]
         -> hasPaths[x, y]
             | x : matrix indexed by [int(1..dimension)] of bool, y : matrix indexed by [int(1..dimension)] of bool]),
    and([hasPaths[x, y] /\ hasPaths[y, z] -> hasPaths[x, z]
             | x : matrix indexed by [int(1..dimension)] of bool, y : matrix indexed by [int(1..dimension)] of bool,
               z : matrix indexed by [int(1..dimension)] of bool]),
    and([!hasPaths[x, x] | x : matrix indexed by [int(1..dimension)] of bool]),
    and([and([[!direction[i, j]
                   | i : matrix indexed by [int(1..dimension)] of bool,
                     j : matrix indexed by [int(1..dimension)] of bool,
                     sum([1 | u : int(1..dimension), i[u] != j[u]]) = 1]
              <=lex
              [!direction
                    [[[i[p[k]], !i[p[k]]; int(0..1)][toInt(b[k])] | k : int(1..dimension)],
                     [[j[p[k]], !j[p[k]]; int(0..1)][toInt(b[k])] | k : int(1..dimension)]]
                   | i : matrix indexed by [int(1..dimension)] of bool,
                     j : matrix indexed by [int(1..dimension)] of bool,
                     sum([1 | u : int(1..dimension), i[u] != j[u]]) = 1]
                  | p : matrix indexed by [int(1..dimension)] of int(1..dimension), allDiff(p)])
             | b : matrix indexed by [int(1..dimension)] of bool]),
    and([or([(direction[a, b] /\ direction[c, d] \/ direction[b, a] /\ direction[d, c]) /\
             (direction[a, d] /\ direction[b, c] \/ direction[d, a] /\ direction[c, b])
             \/
             (direction[a, d] /\ direction[c, b] \/ direction[d, a] /\ direction[b, c]) /\
             (direction[a, b] /\ direction[d, c] \/ direction[b, a] /\ direction[c, d])
                 | a : matrix indexed by [int(1..dimension)] of bool, b : matrix indexed by [int(1..dimension)] of bool,
                   c : matrix indexed by [int(1..dimension)] of bool, d : matrix indexed by [int(1..dimension)] of bool,
                   and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                   and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                   sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q45],
                   sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q45],
                   sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q45] + props_Explicit_2[q45],
                   a <lex b, a <lex c, b <lex d])
             | q45 : int(1..fin1), props_Explicit_4[q45] = -1, props_Explicit_3[q45] = 1]),
    and([and([(direction[a, b] /\ direction[c, d] \/ direction[b, a] /\ direction[d, c]) /\
              (direction[a, d] /\ direction[b, c] \/ direction[d, a] /\ direction[c, b])
              \/
              (direction[a, d] /\ direction[c, b] \/ direction[d, a] /\ direction[b, c]) /\
              (direction[a, b] /\ direction[d, c] \/ direction[b, a] /\ direction[c, d])
                  | a : matrix indexed by [int(1..dimension)] of bool,
                    b : matrix indexed by [int(1..dimension)] of bool,
                    c : matrix indexed by [int(1..dimension)] of bool,
                    d : matrix indexed by [int(1..dimension)] of bool,
                    and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                    and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                    sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q47],
                    sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q47],
                    sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q47] + props_Explicit_2[q47],
                    a <lex b, a <lex c, b <lex d])
             | q47 : int(1..fin1), props_Explicit_4[q47] = -2, props_Explicit_3[q47] = 1]),
    and([props_Explicit_4[q53] =
         sum([toInt((direction[a, b] /\ direction[c, d] \/ direction[b, a] /\ direction[d, c]) /\
                    (direction[a, d] /\ direction[b, c] \/ direction[d, a] /\ direction[c, b])
                    \/
                    (direction[a, d] /\ direction[c, b] \/ direction[d, a] /\ direction[b, c]) /\
                    (direction[a, b] /\ direction[d, c] \/ direction[b, a] /\ direction[c, d]))
                  | a : matrix indexed by [int(1..dimension)] of bool,
                    b : matrix indexed by [int(1..dimension)] of bool,
                    c : matrix indexed by [int(1..dimension)] of bool,
                    d : matrix indexed by [int(1..dimension)] of bool,
                    and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                    and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                    sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q53],
                    sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q53],
                    sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q53] + props_Explicit_2[q53],
                    a <lex b, a <lex c, b <lex d])
             | q53 : int(1..fin1), props_Explicit_4[q53] >= 0, props_Explicit_3[q53] = 1]),
    and([or([direction[a, b] /\ direction[c, d] /\ (direction[a, d] /\ direction[c, b]) \/
             direction[b, a] /\ direction[d, c] /\ (direction[d, a] /\ direction[b, c])
                 | a : matrix indexed by [int(1..dimension)] of bool, b : matrix indexed by [int(1..dimension)] of bool,
                   c : matrix indexed by [int(1..dimension)] of bool, d : matrix indexed by [int(1..dimension)] of bool,
                   and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                   and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                   sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q63],
                   sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q63],
                   sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q63] + props_Explicit_2[q63],
                   a <lex b, a <lex c, b <lex d])
             | q63 : int(1..fin1), props_Explicit_4[q63] = -1, props_Explicit_3[q63] = 2]),
    and([and([direction[a, b] /\ direction[c, d] /\ (direction[a, d] /\ direction[c, b]) \/
              direction[b, a] /\ direction[d, c] /\ (direction[d, a] /\ direction[b, c])
                  | a : matrix indexed by [int(1..dimension)] of bool,
                    b : matrix indexed by [int(1..dimension)] of bool,
                    c : matrix indexed by [int(1..dimension)] of bool,
                    d : matrix indexed by [int(1..dimension)] of bool,
                    and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                    and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                    sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q20],
                    sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q20],
                    sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q20] + props_Explicit_2[q20],
                    a <lex b, a <lex c, b <lex d])
             | q20 : int(1..fin1), props_Explicit_4[q20] = -2, props_Explicit_3[q20] = 2]),
    and([props_Explicit_4[q59] =
         sum([toInt(direction[a, b] /\ direction[c, d] /\ (direction[a, d] /\ direction[c, b]) \/
                    direction[b, a] /\ direction[d, c] /\ (direction[d, a] /\ direction[b, c]))
                  | a : matrix indexed by [int(1..dimension)] of bool,
                    b : matrix indexed by [int(1..dimension)] of bool,
                    c : matrix indexed by [int(1..dimension)] of bool,
                    d : matrix indexed by [int(1..dimension)] of bool,
                    and([a[i] != b[i] <-> c[i] != d[i] | i : int(1..dimension)]),
                    and([a[i] != d[i] <-> b[i] != c[i] | i : int(1..dimension)]),
                    sum([1 | i : int(1..dimension), a[i] != b[i]]) = props_Explicit_1[q59],
                    sum([1 | i : int(1..dimension), a[i] != d[i]]) = props_Explicit_2[q59],
                    sum([1 | i : int(1..dimension), a[i] != c[i]]) = props_Explicit_1[q59] + props_Explicit_2[q59],
                    a <lex b, a <lex c, b <lex d])
             | q59 : int(1..fin1), props_Explicit_4[q59] >= 0, props_Explicit_3[q59] = 2])

